<Window x:Class="Kota.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kota" Width="392" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5"
        Foreground="{DynamicResource Fg}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Sub}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The outer margin leaves room for the drop shadow. -->
    <Border Margin="12" CornerRadius="10" Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28" />
        </Border.Effect>
        <StackPanel Margin="14,12,14,10">
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="OnRefresh" />
                    <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE713;" Click="OnMenu" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Kota" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdatedText" Margin="10,1,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Sub}" FontSize="11.5" />
                </StackPanel>
            </DockPanel>

            <StackPanel x:Name="ProvidersPanel" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="HistoryHint" DockPanel.Dock="Right" Foreground="{DynamicResource Sub}"
                                   FontSize="11.5" Cursor="Help" />
                        <TextBlock x:Name="HistoryTitle" FontWeight="SemiBold" FontSize="13.5" />
                    </DockPanel>
                    <Grid x:Name="StatsGrid" Margin="0,8,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <Grid x:Name="ChartGrid" Height="64" />
                    <Grid x:Name="ChartLabels" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="ProjectsCard" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Name="ProjectsTitle" FontWeight="SemiBold" FontSize="13.5" />
                    <StackPanel x:Name="ProjectsPanel" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="FooterText" Foreground="{DynamicResource Sub}" FontSize="11" Margin="2,0,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms share many type names; we import namespaces explicitly. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Kota</AssemblyName>
    <RootNamespace>Kota.App</RootNamespace>
    <ApplicationIcon>Assets\kota.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF handles DPI; the manifest just makes the tray icon render at the right size. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\kota.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kota.Core\Kota.Core.csproj" />
  </ItemGroup>

</Project>
